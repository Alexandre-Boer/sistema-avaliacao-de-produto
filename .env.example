# Copie este arquivo para .env.local e preencha os valores.
# O .env.local não é versionado.

# --- Supabase (obrigatório) ---------------------------------------------------
# Painel do Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "service_role". Dá acesso total ao banco: use só no servidor e nunca a publique.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessão (obrigatório) -----------------------------------------------------
# Segredo que assina o cookie de sessão. Gere um valor aleatório longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Resumo da IA (opcional) --------------------------------------------------
# Sem nada configurado aqui a aplicação funciona, só sem o bloco "Resumo da IA".

# Opção A: modelo local gratuito via Ollama (ver ollama/docker-compose.yml).
AI_SUMMARY_MODEL=custom/gemma3:4b
AI_SUMMARY_BASE_URL=http://localhost:11434/v1

# Opção B: OpenAI. Apague as duas linhas da opção A e defina a chave.
# O modelo padrão é openai/gpt-4o-mini; AI_SUMMARY_MODEL permite trocar.
# OPENAI_API_KEY=
